---
/**
 * 流场主题：基于柏林噪声的粒子流场背景 + 构图驱动的主视觉。
 * 主视觉区域由背景构图（画框预设）决定落点，每次进入随机一种构图。
 * 行为逻辑（p5 初始化、构图应用）在同目录 client.ts，由主题加载器按需激活。
 */
import { CurrentYear } from '~/components';
import { Palette } from '~/components/icons';
import { FILING, HOME_ENTRY_ITEMS, HOME_SOCIAL_ITEMS } from '~/consts';
---

<!-- 画布底色须与 utils/flow-field/config.ts 的 BG_COLOR 一致 -->
<div id="flow-field-container" class="absolute inset-0 bg-black"></div>

<!-- 主视觉：定位到构图指定的区域（坐标与全屏画布一致），初始 opacity-0，待构图确定后再显现，避免可见的位移跳动 -->
<header
  id="hero"
  class="absolute z-[1] flex opacity-0 transition-opacity duration-500 ease-out items-center justify-center p-[6vw] text-white"
>
  <div id="hero-block" class="flex flex-col text-shadow-lg items-center text-center">
    <!-- 主标题：clamp 让字号随 vw 流动的同时兜住两端——下限 1.5rem(≈原 text-2xl) 保小屏可读，
         上限 4.5rem(≈1920px 处 3.8vw) 防超宽屏失控（纯 3.8vw 在 2560/3440px 会涨到 97/131px 过大） -->
    <h1 class="hero-title text-[clamp(1.5rem,3.8vw,4.5rem)] font-[500] leading-[1.4] m-0">
      <div>ceynri, Frontend Developer</div>
      <div>based in Guangdong, China</div>
    </h1>
    <!-- 副标题：clamp 同主标题，下限 1rem(≈原 text-base) 保可读、上限 1.75rem 防超宽屏过大；
         max-width 用 em 锚定字号，无论字号由 clamp 如何取值，行内字数恒定 -->
    <div class="text-[clamp(1rem,1.5vw,1.75rem)] max-w-[20em] max-sm:max-w-[80vw] mt-6">
      我在这里写点博客，分享我对于生活与日常的一些思考。
    </div>
    <!-- 入口导航栏 -->
    <nav class="flex gap-4 mt-10">
      {HOME_ENTRY_ITEMS.map((item) => (
        <a
          href={item.href}
          class="flex items-center justify-center w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 active:opacity-50 transition-[background-color,opacity] duration-300 ease-out"
          title={item.name}
        >
          <item.icon class="size-6" />
        </a>
      ))}
    </nav>
  </div>
</header>

<!-- 禁用 JS 且本主题为兜底主题时强制显现主视觉（hero 初始 opacity-0 依赖 JS 淡入） -->
<noscript>
  <style>
    #hero {
      opacity: 1 !important;
    }
  </style>
</noscript>

<!-- 四角是本主题自己的，不和别的主题共用组件 -->
<div class="ff-chrome pointer-events-none absolute inset-0 z-[2] p-8 max-sm:p-5">
  <div class="relative size-full">
    <div class="absolute top-0 left-0">ceynri.cn</div>
    <div class="pointer-events-auto absolute top-0 right-0 flex gap-6">
      {
        HOME_SOCIAL_ITEMS.map((item) => (
          <a
            href={item.href}
            class="ff-dim transition-[color,opacity] active:opacity-50"
            title={item.name}
            rel="noopener"
            aria-label={item.name}
            target="_blank"
          >
            <item.icon class="size-6" />
          </a>
        ))
      }
    </div>
    <div class="pointer-events-auto absolute bottom-0 left-0 flex items-end gap-3">
      <button
        type="button"
        data-theme-switch
        class="flex h-8 cursor-pointer items-center gap-1.5 text-xs tracking-[0.08em] transition-[color,opacity] active:opacity-50"
        aria-label="切换主题"
        title="切换主题"
      >
        <Palette class="size-4" />
        <span data-theme-switch-name>流场</span>
      </button>
    </div>
    <footer class="pointer-events-auto absolute right-0 bottom-0 text-right text-xs leading-[1.75]">
      <div class="max-sm:hidden">
        <a
          href="https://github.com/wangyasai/Perlin-Noise"
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors"
        >
          背景灵感来自 wangyasai/Perlin-Noise
        </a>
      </div>
      <div>Ceynri © 2020-<CurrentYear /></div>
      <a
        href={FILING.link}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="block transition-colors"
      >
        {FILING.text}
      </a>
    </footer>
  </div>
</div>

<style>
  .ff-chrome {
    --chrome: #e6eaee;
    --chrome-strong: #ffffff;
    --chrome-dim: #e6eaee;
    color: var(--chrome);
    text-shadow: 0 0 2px rgb(0 0 0 / 0.55);
  }
  .ff-chrome .ff-dim {
    color: var(--chrome-dim);
  }
  .ff-chrome :is(a, button):hover {
    color: var(--chrome-strong);
  }
</style>
