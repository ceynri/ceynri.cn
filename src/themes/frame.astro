---
/**
 * 可选的四角边框：站名、社交、主题切换、页脚。
 * 舞台不再持有一份跨主题的 chrome。主题想用这套边角就自己放进来；
 * 颜色也由调用方传入，不读别的主题的配色。
 */
import { CurrentYear } from '~/components';
import BgmPlayer from '~/components/bgm-player.astro';
import { Palette } from '~/components/icons';
import { FILING, HOME_SOCIAL_ITEMS } from '~/consts';
import { HOME_THEMES } from './registry';
import type { HomeThemeId } from './types';

interface Props {
  themeId: HomeThemeId;
  /** 本主题自己挂载 BGM。不要靠跨主题显隐去共用同一个播放器 */
  bgm?: boolean;
  /** 文字、图标、悬停。写到本层的 CSS 变量上，只影响这一份边框 */
  color: string;
  strong: string;
  dim: string;
  /** 仅这一份边框的文字光晕，不传给其他主题 */
  shadow?: boolean;
}

const { themeId, bgm = false, color, strong, dim, shadow = false } = Astro.props;
const theme = HOME_THEMES.find((item) => item.id === themeId);
---

<div
  class:list={['home-frame pointer-events-none absolute inset-0 z-[2] p-8 max-sm:p-5', shadow && 'is-shadow']}
  style={`--chrome:${color};--chrome-strong:${strong};--chrome-dim:${dim}`}
>
  <div class="relative size-full">
    <div class="absolute top-0 left-0">ceynri.cn</div>

    <div class="pointer-events-auto absolute top-0 right-0 flex gap-6">
      {
        HOME_SOCIAL_ITEMS.map((item) => (
          <a
            href={item.href}
            class="chrome-dim transition-[color,opacity] active:opacity-50"
            title={item.name}
            rel="noopener"
            aria-label={item.name}
            target="_blank"
          >
            <item.icon class="size-6" />
          </a>
        ))
      }
    </div>

    <!-- h-8 + items-end：切换按钮贴在同一条底边上，旁边有没有音量条都不改变它的位置 -->
    <div class="pointer-events-auto absolute bottom-0 left-0 flex items-end gap-3">
      <button
        type="button"
        data-theme-switch
        class="flex h-8 cursor-pointer items-center gap-1.5 text-xs tracking-[0.08em] transition-[color,opacity] active:opacity-50"
        aria-label="切换主题"
        title="切换主题"
      >
        <Palette class="size-4" />
        <span data-theme-switch-name>{theme?.name}</span>
      </button>
      {bgm && <BgmPlayer bgmThemes={themeId} />}
    </div>

    <footer class="pointer-events-auto absolute right-0 bottom-0 text-right text-xs leading-[1.75]">
      {
        theme?.credit && (
          <div class="max-sm:hidden">
            {theme.credit.href ? (
              <a
                href={theme.credit.href}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors"
              >
                {theme.credit.text}
              </a>
            ) : (
              theme.credit.text
            )}
          </div>
        )
      }
      <div>Ceynri © 2020-<CurrentYear /></div>
      <a
        href={FILING.link}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="block transition-colors"
      >
        {FILING.text}
      </a>
    </footer>
  </div>
</div>

<style>
  .home-frame {
    color: var(--chrome);
  }
  .home-frame.is-shadow {
    text-shadow: 0 0 2px rgb(0 0 0 / 0.55);
  }
  .home-frame .chrome-dim {
    color: var(--chrome-dim);
  }
  .home-frame :is(a, button):hover {
    color: var(--chrome-strong);
  }
</style>
