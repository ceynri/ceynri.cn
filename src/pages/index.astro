---
/**
 * 首页舞台：只负责把各主题整页渲染出来，并在首帧前选定可见主题。
 * 边角、导航、页脚都由主题自己排布，舞台不再放一份跨主题的 chrome。
 */
import { SITE_DESCRIPTION, SITE_TITLE } from '~/consts';
import BaseLayout from '~/layouts/base-layout.astro';
import FlowField from '~/home-themes/flow-field/index.astro';
import NightFishing from '~/home-themes/night-fishing/index.astro';
import { DEFAULT_THEME, HOME_THEMES, LAST_THEME_KEY } from '~/home-themes/registry';

const themeIds = HOME_THEMES.map((theme) => theme.id);
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
>
  <Fragment slot="head">
    <script
      is:inline
      define:vars={{ themeIds, defaultTheme: DEFAULT_THEME, lastThemeKey: LAST_THEME_KEY }}
    >
      try {
        const params = new URLSearchParams(location.search);
        const requested = params.get('theme');
        // 命中注册表才算强制指定；强制指定不写 localStorage，刷新仍可随机到别的主题
        let theme = themeIds.includes(requested) ? requested : '';
        if (!theme) {
          let last = '';
          try {
            last = localStorage.getItem(lastThemeKey) || '';
          } catch {
            last = '';
          }
          const candidates = themeIds.filter((id) => id !== last);
          theme = candidates.length > 0 ? candidates[Math.floor(Math.random() * candidates.length)] : themeIds[0];
          try {
            localStorage.setItem(lastThemeKey, theme);
          } catch {
            // 隐私模式等场景下写入失败不影响本次展示
          }
        }
        document.documentElement.dataset.homeTheme = theme;
        // 每条主题一条显示规则：运行时切换只改 data-home-theme，不必重写样式
        const showRules = themeIds
          .map((id) => `html[data-home-theme="${id}"] [data-home-theme-only="${id}"]{display:block}`)
          .join('');
        const style = document.createElement('style');
        style.textContent = `[data-home-theme-only]{display:none}${showRules}`;
        document.head.appendChild(style);
      } catch {
        document.documentElement.dataset.homeTheme = defaultTheme;
      }
    </script>
  </Fragment>

  <main class="fixed inset-0">
    {HOME_THEMES.map((theme) => (
      <section
        data-home-theme-only={theme.id}
        data-home-theme-default={theme.id === DEFAULT_THEME ? '' : undefined}
        class="absolute inset-0"
      >
        {theme.id === 'night-fishing' && <NightFishing />}
        {theme.id === 'flow-field' && <FlowField />}
      </section>
    ))}
  </main>

  <script>
    import { initThemeLoader } from '~/home-themes/loader';

    initThemeLoader();
  </script>
</BaseLayout>
